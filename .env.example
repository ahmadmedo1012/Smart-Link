# SmartLink — environment template
# Copy to .env.local for local development. NEVER commit real keys:
# .env* is gitignored (secrets that reached a public repo's history get
# auto-revoked — that is exactly how the round-0 tokens died).

# Resend — transactional email (contact form)
# Dashboard: https://resend.com/api-keys
# Without it the API fails LOUD with 503 (never a fake success).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
