# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets
.env*
!.env.example
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated / dev artifacts
.claude-flow/
.claude/
.playwright-mcp/
# root-anchored (r132 W3-4): ad-hoc root screenshot dirs stay ignored,
# while docs/screenshots/ (versioned README assets) is trackable
/screenshots/

# playwright e2e artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
