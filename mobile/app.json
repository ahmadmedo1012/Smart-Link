{
  "//": "P36-G: أُزيل مرشّح App Links على smart-link.ly (كان autoVerify:true) — تطبيق المظلة الأصلي هذا ليس تطبيق النطاق: مالك النطاق هو PWA الويب (assetlinks.json غير منشور ويجب ألا يُنشر)، وحكم P36 يمنع تطبيقاً أصلياً رابعاً يخطف روابط النطاق. دليل الهوية والتبويبات يبقى كما هو.",
  "expo": {
    "name": "SmartLink",
    "slug": "smartlink",
    "version": "1.0.0",
    "orientation": "portrait",
    "description": "المظلة الرقمية لأعمالك في ليبيا — بوابة منظومة Smart: الخدمات والأسعار والتواصل تحت رابط واحد.",
    "icon": "./assets/images/icon.png",
    "scheme": "smartlink",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050507",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ly.smartlink.hub",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "ly.smartlink.hub",
      "adaptiveIcon": {
        "backgroundColor": "#050507",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050507",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://smart-link.ly",
      "router": {}
    }
  }
}
